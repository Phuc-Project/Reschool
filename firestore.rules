rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: reschool_items
    // Document ID: itemId (string, e.g. "item-1713398400000")
    // Fields:
    //   - id: string (optional, max 128 chars) - Document ID reference
    //   - user_id: string (required, 1-128 chars, immutable) - Author student UID
    //   - title: string (required, 3-150 chars) - Title of item
    //   - type: string (required, in ['GIVE', 'RECEIVE']) - Item exchange type
    //   - category: string (required, in ['TEXTBOOK', 'UNIFORM', 'STATIONERY', 'OTHER']) - Item category
    //   - grade: int (optional, 1-12 or null) - School grade level
    //   - condition: string (optional, max 100 chars) - Item physical condition
    //   - description: string (optional, max 2000 chars) - Detailed description
    //   - images: list (optional, max 10 items) - Photos of the item
    //   - tags: list (optional, max 20 items) - Categorization tags
    //   - status: string (required, in ['AVAILABLE', 'RESERVED', 'COMPLETED']) - Circulation status
    //   - created_at: string|timestamp (optional, max 50 chars if string, immutable) - Creation time
    //   - updated_at: string|timestamp (optional, max 50 chars if string) - Last update time
    //   - view_count: number (optional, >= 0) - Total view impressions
    //   - location: map (optional) - School name, city, district, lat, lng
    //   - contact: map (optional) - Author name, phone, email, zalo, class
    //
    // Collection: student_profiles
    // Document ID: userId (string, matches Firebase Auth UID)
    // Fields:
    //   - uid: string (required, matches userId, immutable) - Auth UID
    //   - displayName: string (required, 1-100 chars) - Full student name
    //   - school: string (required, 1-150 chars) - School name
    //   - district: string (required, 1-100 chars) - District / County
    //   - phone: string (required, 5-25 chars) - Contact phone number
    //   - city: string (optional, max 100 chars) - Province / City
    //   - studentClass: string (optional, max 50 chars) - Class name (e.g. 10A1)
    //   - grade: int (optional, 1-12 or null) - Grade level
    //   - email: string (optional, max 100 chars) - Google email
    //   - photoURL: string (optional, max 2048 chars) - Avatar URL
    //   - zalo: string (optional, max 100 chars) - Zalo contact
    //   - defaultAddress: string (optional, max 250 chars) - Convenient meeting point
    //   - profileCompleted: bool (optional) - Profile completion flag
    //   - createdAt: string|timestamp (optional, immutable) - Registration timestamp
    //   - updatedAt: string|timestamp (optional) - Profile update timestamp
    //
    // ===============================================================

    // Default Deny: Deny all reads and writes by default across any unlisted path
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidDate(val) {
      return val is timestamp || (val is string && val.size() <= 50);
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, allowedFields) {
      return data.keys().hasOnly(allowedFields);
    }

    // ===============================================================
    // Domain Validators: reschool_items
    // ===============================================================

    function isValidItemLocation(loc) {
      return loc is map &&
             loc.keys().hasOnly(['school_name', 'city', 'district', 'address_detail', 'latitude', 'longitude']) &&
             (!('school_name' in loc) || (loc.school_name is string && loc.school_name.size() <= 150)) &&
             (!('city' in loc) || (loc.city is string && loc.city.size() <= 100)) &&
             (!('district' in loc) || (loc.district is string && loc.district.size() <= 100)) &&
             (!('address_detail' in loc) || loc.address_detail == null || (loc.address_detail is string && loc.address_detail.size() <= 250)) &&
             (!('latitude' in loc) || loc.latitude is number) &&
             (!('longitude' in loc) || loc.longitude is number);
    }

    function isValidItemContact(contact) {
      return contact is map &&
             contact.keys().hasOnly(['user_id', 'author_name', 'author_avatar', 'student_class', 'phone', 'zalo', 'email']) &&
             (!('user_id' in contact) || (contact.user_id is string && contact.user_id.size() <= 128)) &&
             (!('author_name' in contact) || (contact.author_name is string && contact.author_name.size() <= 100)) &&
             (!('author_avatar' in contact) || (contact.author_avatar is string && contact.author_avatar.size() <= 2048)) &&
             (!('student_class' in contact) || (contact.student_class is string && contact.student_class.size() <= 50)) &&
             (!('phone' in contact) || (contact.phone is string && contact.phone.size() <= 25)) &&
             (!('zalo' in contact) || (contact.zalo is string && contact.zalo.size() <= 100)) &&
             (!('email' in contact) || (contact.email is string && contact.email.size() <= 100));
    }

    function isValidReschoolItem(data) {
      let allowedFields = [
        'id', 'user_id', 'title', 'type', 'category', 'grade',
        'condition', 'description', 'images', 'tags', 'status',
        'created_at', 'updated_at', 'view_count', 'location', 'contact'
      ];
      let requiredFields = ['title', 'type', 'category', 'status', 'user_id'];

      return hasRequiredFields(data, requiredFields) &&
             hasOnlyAllowedFields(data, allowedFields) &&
             data.title is string && data.title.size() >= 3 && data.title.size() <= 150 &&
             data.type in ['GIVE', 'RECEIVE'] &&
             data.category in ['TEXTBOOK', 'UNIFORM', 'STATIONERY', 'OTHER'] &&
             data.status in ['AVAILABLE', 'RESERVED', 'COMPLETED'] &&
             data.user_id is string && data.user_id.size() >= 1 && data.user_id.size() <= 128 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('grade' in data) || data.grade == null || (data.grade is int && data.grade >= 1 && data.grade <= 12)) &&
             (!('condition' in data) || (data.condition is string && data.condition.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000)) &&
             (!('images' in data) || (data.images is list && data.images.size() <= 10)) &&
             (!('tags' in data) || (data.tags is list && data.tags.size() <= 20)) &&
             (!('view_count' in data) || (data.view_count is number && data.view_count >= 0)) &&
             (!('created_at' in data) || isValidDate(data.created_at)) &&
             (!('updated_at' in data) || isValidDate(data.updated_at)) &&
             (!('location' in data) || isValidItemLocation(data.location)) &&
             (!('contact' in data) || isValidItemContact(data.contact));
    }

    function isValidItemPartialUpdate() {
      let affected = request.resource.data.diff(resource.data).affectedKeys();
      return affected.hasOnly(['view_count', 'status', 'updated_at']) &&
             (!affected.hasAny(['view_count']) || (request.resource.data.view_count is number && request.resource.data.view_count >= 0)) &&
             (!affected.hasAny(['status']) || request.resource.data.status in ['AVAILABLE', 'RESERVED', 'COMPLETED']) &&
             (!affected.hasAny(['updated_at']) || isValidDate(request.resource.data.updated_at));
    }

    // ===============================================================
    // Domain Validators: student_profiles
    // ===============================================================

    function isValidStudentProfile(data) {
      let allowedFields = [
        'uid', 'displayName', 'email', 'photoURL', 'school',
        'district', 'city', 'studentClass', 'grade', 'phone',
        'zalo', 'defaultAddress', 'profileCompleted', 'createdAt', 'updatedAt'
      ];
      let requiredFields = ['uid', 'displayName', 'school', 'district', 'phone'];

      return hasRequiredFields(data, requiredFields) &&
             hasOnlyAllowedFields(data, allowedFields) &&
             data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
             data.school is string && data.school.size() >= 1 && data.school.size() <= 150 &&
             data.district is string && data.district.size() >= 1 && data.district.size() <= 100 &&
             data.phone is string && data.phone.size() >= 5 && data.phone.size() <= 25 &&
             (!('city' in data) || (data.city is string && data.city.size() <= 100)) &&
             (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 100)) &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 2048)) &&
             (!('studentClass' in data) || data.studentClass == null || (data.studentClass is string && data.studentClass.size() <= 50)) &&
             (!('grade' in data) || data.grade == null || (data.grade is int && data.grade >= 1 && data.grade <= 12)) &&
             (!('zalo' in data) || data.zalo == null || (data.zalo is string && data.zalo.size() <= 100)) &&
             (!('defaultAddress' in data) || data.defaultAddress == null || (data.defaultAddress is string && data.defaultAddress.size() <= 250)) &&
             (!('profileCompleted' in data) || data.profileCompleted is bool) &&
             (!('createdAt' in data) || isValidDate(data.createdAt)) &&
             (!('updatedAt' in data) || isValidDate(data.updatedAt));
    }

    // ===============================================================
    // Rules: reschool_items
    // ===============================================================

    match /reschool_items/{itemId} {
      // 1. allow read: public read for student item feed and map
      allow read: if true;

      // 2. allow create: authenticated student post with required fields and owner user_id
      allow create: if isAuthenticated() &&
                       isValidReschoolItem(request.resource.data) &&
                       request.resource.data.user_id == request.auth.uid;

      // 3. allow update: owner full update OR non-owner restricted metadata update
      allow update: if isAuthenticated() && (
        // Case A: Owner updating their own item
        (
          resource.data.user_id == request.auth.uid &&
          isValidReschoolItem(request.resource.data) &&
          request.resource.data.user_id == resource.data.user_id &&
          (!('id' in resource.data) || !('id' in request.resource.data) || request.resource.data.id == resource.data.id) &&
          (!('created_at' in resource.data) || !('created_at' in request.resource.data) || request.resource.data.created_at == resource.data.created_at)
        ) ||
        // Case B: Controlled partial update of view_count, status, or updated_at
        isValidItemPartialUpdate()
      );

      // 4. allow delete: item owner only
      allow delete: if isAuthenticated() &&
                       resource.data.user_id == request.auth.uid;
    }

    // ===============================================================
    // Rules: student_profiles
    // ===============================================================

    match /student_profiles/{userId} {
      // 1. allow read: authenticated students
      allow read: if isAuthenticated();

      // 2. allow create: owner creating profile with matching userId
      allow create: if isAuthenticated() &&
                       isOwner(userId) &&
                       isValidStudentProfile(request.resource.data) &&
                       request.resource.data.uid == userId;

      // 3. allow update: owner updating profile with immutable uid and createdAt
      allow update: if isAuthenticated() &&
                       isOwner(userId) &&
                       isValidStudentProfile(request.resource.data) &&
                       request.resource.data.uid == resource.data.uid &&
                       (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt);

      // 4. allow delete: owner only
      allow delete: if isAuthenticated() &&
                       isOwner(userId);
    }
  }
}
