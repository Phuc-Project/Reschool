# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Firebase Project Configuration
# Tạo dự án trên console.firebase.google.com và lấy Service Account Key (JSON)
FIREBASE_PROJECT_ID=reschool-vietnam-project
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:5500","http://127.0.0.1:5500","http://localhost:8080","http://127.0.0.1:8080"]
